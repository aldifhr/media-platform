# === media-platform unified env ===
# Contract follows manhwa-scanner (the component already on the Discord bot).
# Real environment always wins over this file. NEVER commit .env.

# --- Discord (bot API; token ONLY in the platform-discord process) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=            # Ed25519 interactions verify key
DISCORD_GATEWAY_ENABLED=false  # gateway-websocket fallback when REST is IP-blocked

# --- Platform auth (single-secret mode) ---
MONITOR_AUTH_TOKEN=            # covers DASHBOARD_PASSWORD / AUTH_SECRET / OPS_SESSION_SECRET
CRON_SECRET=

# --- Datastore (native on VPS, no Docker) ---
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/media_platform
REDIS_URL=redis://127.0.0.1:6379/0

# --- Frontend ---
BACKEND_URL=https://media-backend.aldifhr.my.id

# --- pahe source tuning (media module) ---
PAHE_MIN_YEAR=2026
PAHE_ALLOWED_TAGS=
PAHE_CHECK_INTERVAL_MINUTES=30
PAHE_THREAD_2025=
PAHE_THREAD_2026=
PAHE_THREAD_HORROR=
TRANSLATE_URL=

# --- Logging ---
LOG_LEVEL=INFO
