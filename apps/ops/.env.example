# media-platform ops / bot-config UI (Next.js 16, deploys on Vercel)
# ADMIN_URL = public URL of the platform-admin API (e.g. https://media-backend.aldifhr.my.id/admin)
# ADMIN_TOKEN = MONITOR_AUTH_TOKEN (server-side only; never exposed to the browser)
ADMIN_URL=http://127.0.0.1:8002
ADMIN_TOKEN=

# Dashboard login. OPS_PASSWORD is the password you type at /login.
# OPS_SESSION_SECRET signs the session cookie; set it to a long random string.
# If OPS_SESSION_SECRET is unset, OPS_PASSWORD is used as the signing key.
OPS_PASSWORD=
OPS_SESSION_SECRET=
